# Backend settings: the API, the worker and the scripts in scripts/ and apps/api/scripts/.
# Copy to .env at the repo root (gitignored) and fill in only what you use; every value here is a
# placeholder. Load it with `uv run --env-file ../../.env ...` from apps/api. Every setting and its default
# is in apps/api/app/settings.py. The web apps read their own .env.local (see apps/web/.env.example and
# apps/ops/.env.example).
#
# With nothing set, the API runs keyless: fake models, sandbox connectors, the local compose stack.

# --- Runtime -----------------------------------------------------------------------------------------
# temporal: runs execute as Temporal workflows. off (default): the API serves data only.
NM_RUNTIME=temporal
# 1: run the worker inside the API process (one Cloud Run service). Unset: start `python -m app.worker`.
NM_EMBEDDED_WORKER=1
# Concurrent activities per worker, and the largest Postgres pool per process (both default 8).
NM_WORKER_CONCURRENCY=
NM_DB_POOL_MAX=

# --- Models: Gemini on Vertex AI ---------------------------------------------------------------------
# test (default): a scripted fake provider, no keys. dev | prod: the models in definitions/models.yaml.
NM_MODEL_ENV=test
# The project billed for model calls. Credentials are Application Default Credentials: the service
# account on Cloud Run, `gcloud auth application-default login` locally. No API key.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Vertex AI location (default: global).
GOOGLE_CLOUD_LOCATION=global

# --- Decision model (Jev) ----------------------------------------------------------------------------
# Answers the typed questions a Decision Node asks. Never log the key.
JEV_API_KEY=
# off | fake | live. Unset: fake under NM_MODEL_ENV=test, live when JEV_API_KEY is set, else off.
NM_JEV=
# Overrides: endpoint, model, and the USD price per million tokens used when the endpoint reports no cost.
NM_JEV_URL=
NM_JEV_MODEL=
NM_JEV_USD_PER_MTOK_IN=
NM_JEV_USD_PER_MTOK_OUT=

# --- Temporal ----------------------------------------------------------------------------------------
# Local compose: 127.0.0.1:7243 and default. Temporal Cloud: the namespace endpoint, plus TEMPORAL_API_KEY
# (setting it turns on TLS).
TEMPORAL_TARGET=127.0.0.1:7243
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
# Task queue (default nm-packs) and a run workflow id prefix for databases sharing one dev Temporal.
NM_TASK_QUEUE=
NM_WORKFLOW_ID_PREFIX=

# --- Database ----------------------------------------------------------------------------------------
# Use 127.0.0.1, not localhost, on Windows. Defaults: the compose Postgres on 5442 (nm and nm_test).
NM_DATABASE_URL=postgresql://nm:nm@127.0.0.1:5442/nm
NM_TEST_DATABASE_URL=postgresql://nm:nm@127.0.0.1:5442/nm_test

# --- Auth and origins --------------------------------------------------------------------------------
# dev: every request is the workspace owner (refused on Cloud Run). Unset: Firebase ID tokens.
AUTH_MODE=dev
# The Firebase project whose ID tokens the API accepts (required unless AUTH_MODE=dev).
FIREBASE_PROJECT_ID=
# CORS origins, comma-separated; the first is where app sign-in links return unless NM_WEB_ORIGIN is set.
ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3400
NM_WEB_ORIGIN=
# The demo user's Firebase uid: real app connections are owned by this id.
DEMO_USER_UID=

# --- Workspace and definitions -----------------------------------------------------------------------
# demo (default): the fixture workspace alongside real rows. live: definitions and real rows only.
NM_WORKSPACE=demo
# 1: validate and apply definitions/ at API startup.
NM_DEFS_AUTO_APPLY=1
# Overrides for an image that copies definitions elsewhere.
NM_DEFS_DIR=
NM_SCHEMAS_DIR=

# --- App connections (Composio) ----------------------------------------------------------------------
# sandbox (default): tool calls answer from sandbox data. live | auto: real app accounts.
NM_CONNECTOR_MODE=sandbox
# Project key for real app connections in the live workspace.
COMPOSIO_API_KEY=
# 32 bytes, URL-safe base64, sealing the tokens of each org's own MCP servers (AES-GCM). Unset: nothing
# is sealed or opened. Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
NM_SECRETS_KEY=

# --- Platform MCP server (driver: mcp connectors) ----------------------------------------------------
# Streamable-HTTP endpoint: https, or http to a loopback host only. Never log it or the token.
NM_MCP_URL=
NM_MCP_TOKEN=
# 1: allow write mappings (off by default; the server runs read-only).
NM_MCP_WRITES=
# Database the MCP tools use (default nm_demo).
NM_MCP_DATABASE=
# scripts/demo_data/load.py: the target demo database (or pass --target-url).
DEMO_MONGO_URL=

# --- Tracing (Langfuse) ------------------------------------------------------------------------------
# With all three set, every agent model call (its prompt, output, token usage and cost) is sent to this
# Langfuse project, one trace per run. Leave any of them empty and nothing is sent. Never log the keys.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
