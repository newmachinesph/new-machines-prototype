    "api:gen": "openapi-ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "5.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.1",
    "clsx": "^2.1.1",
    "firebase": "13.0.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "nuqs": "2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
