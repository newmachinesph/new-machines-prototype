{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.newmachin.es/nm.memory_space.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "retention_days",
    "readers",
    "writers"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1
    },
    "readers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seed_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
