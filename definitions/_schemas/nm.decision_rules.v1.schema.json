{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.newmachin.es/nm.decision_rules.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "rules",
    "default"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "verdict",
          "route",
          "reason_code",
          "explanation"
        ],
        "properties": {
          "when": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "APPROVED",
              "HUMAN_REVIEW",
              "BLOCKED",
              "REJECTED"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "route",
        "reason_code",
        "explanation"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "APPROVED",
            "HUMAN_REVIEW",
            "BLOCKED",
            "REJECTED"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "questions", "on_error"],
      "dependentRequired": {"for_each": ["ref"], "ref": ["for_each"], "keep": ["for_each"]},
      "properties": {
        "kind": {"const": "jev"},
        "for_each": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "state": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 5,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "not": {"enum": ["in", "true", "false", "null"]}
          },
          "additionalProperties": {"$ref": "#/$defs/question"}
        },
        "keep": {"type": "string", "minLength": 1},
        "on_error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "route", "reason_code", "explanation"],
          "properties": {
            "verdict": {"enum": ["HUMAN_REVIEW", "BLOCKED", "REJECTED"]},
            "route": {"type": "string", "minLength": 1},
            "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "explanation": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": {"const": "noul"},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 500},
            "criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": ["true", "false"],
              "properties": {
                "true": {"type": "string", "minLength": 1, "maxLength": 300},
                "false": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": {"const": "choice"},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 500},
            "criteria": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 10,
              "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,39}$"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": {"const": "score"},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 500},
            "criteria": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 11,
              "propertyNames": {"pattern": "^(10|[0-9])$"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        }
      ]
    }
  }
}
