{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.newmachin.es/nm.pack.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "version",
    "publisher",
    "function",
    "industries",
    "outcome",
    "description",
    "risk_class",
    "price_note",
    "workflow",
    "contract",
    "agents",
    "connectors",
    "human_review"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "function": {
      "type": "string",
      "minLength": 1
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "price_note": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "human_review": {
      "type": "string",
      "minLength": 1
    }
  }
}
