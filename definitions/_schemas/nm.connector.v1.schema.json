{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.newmachin.es/nm.connector.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "tools",
    "defaults"
  ],
  "properties": {
    "app": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "enum": [
        "composio",
        "mcp"
      ],
      "default": "composio"
    },
    "toolkit": {
      "type": "string",
      "minLength": 1
    },
    "server": {
      "type": "string",
      "pattern": "^mcp_[0-9a-f]{12}$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "action_class",
          "capability",
          "description",
          "input_schema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]{8}_[0-9]{2}$"
          },
          "action_class": {
            "enum": [
              "read",
              "write",
              "delete",
              "money"
            ]
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "object"
          },
          "sample": {
            "type": "object"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "delete",
        "money"
      ],
      "properties": {
        "read": {
          "enum": [
            "permit",
            "require_approval",
            "deny"
          ]
        },
        "write": {
          "enum": [
            "permit",
            "require_approval",
            "deny"
          ]
        },
        "delete": {
          "enum": [
            "permit",
            "require_approval",
            "deny"
          ]
        },
        "money": {
          "enum": [
            "permit",
            "require_approval",
            "deny"
          ]
        }
      }
    }
  },
  "if": {
    "properties": {
      "transport": {
        "const": "mcp"
      }
    },
    "required": [
      "transport"
    ]
  },
  "then": {
    "required": [
      "server"
    ],
    "not": {
      "required": [
        "toolkit"
      ]
    }
  },
  "else": {
    "required": [
      "toolkit"
    ],
    "not": {
      "required": [
        "server"
      ]
    },
    "properties": {
      "tools": {
        "minItems": 1
      }
    }
  }
}
