{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reminder plan",
  "description": "The overdue invoices, one reminder message each, and what a reviewer checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "messages", "review_items"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "description": "One or two plain sentences."},
    "messages": {
      "type": "array",
      "description": "One reminder per overdue invoice.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "about", "facts"],
        "properties": {
          "to": {"type": "string", "minLength": 3, "description": "The customer's email address."},
          "about": {"type": "string", "minLength": 1, "maxLength": 150},
          "facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ref": {"type": "string", "minLength": 1, "description": "The invoice number the message is about."}
        }
      }
    },
    "review_items": {
      "type": "array",
      "description": "One per overdue invoice (the shared review item shape).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "date", "amount_minor", "currency", "flag", "note"],
        "properties": {
          "ref": {"type": "string", "minLength": 1, "description": "The invoice number."},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The due date."},
          "amount_minor": {"type": "integer", "description": "Amount due in minor units (cents)."},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "flag": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "counterpart_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
