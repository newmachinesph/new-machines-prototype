{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconciliation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["since", "until", "spreadsheet_id"],
  "properties": {
    "since": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "First day to reconcile, inclusive (YYYY-MM-DD)."
    },
    "until": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last day to reconcile, inclusive (YYYY-MM-DD)."
    },
    "spreadsheet_id": {
      "type": "string",
      "title": "Spreadsheet ID",
      "minLength": 30,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "default": "sandbox-reconciliation-sheet-00000001",
      "description": "The Google Sheets spreadsheet the report is added to: the long ID in the sheet's URL.",
      "errorMessage": "Use the spreadsheet ID from the sheet's URL: 30 or more letters, digits, hyphens (-) or underscores (_)."
    }
  }
}
