{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Support inbox triage request",
  "type": "object",
  "additionalProperties": false,
  "required": ["spreadsheet_id"],
  "properties": {
    "spreadsheet_id": {
      "type": "string",
      "minLength": 30,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "default": "sandbox-support-cases-sheet-0000001",
      "description": "The case log spreadsheet's id, from its URL. Rows are added to its Cases tab."
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "default": "in:inbox newer_than:3d",
      "description": "Which emails to sort, as a Gmail search."
    }
  }
}
