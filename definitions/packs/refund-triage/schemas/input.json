{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refund triage request",
  "type": "object",
  "additionalProperties": false,
  "required": ["since", "until"],
  "properties": {
    "since": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "First day of refund requests to triage, inclusive (YYYY-MM-DD)."
    },
    "until": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last day of refund requests to triage, inclusive (YYYY-MM-DD)."
    }
  }
}
