{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refund triage",
  "description": "One proposed decision per refund request, a reply for each, and what a reviewer checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "cases", "messages", "review_items"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "description": "One or two plain sentences."},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id", "from", "order_id", "charge_id", "requested_minor", "currency",
          "recommendation", "amount_minor", "reason"
        ],
        "properties": {
          "thread_id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 3, "description": "The sender's email address."},
          "order_id": {"type": ["string", "null"], "description": "Order name, such as #1003. Null when none matches."},
          "charge_id": {"type": ["string", "null"], "description": "Charge id. Null when none matches."},
          "requested_minor": {"type": "integer", "minimum": 0},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "recommendation": {"enum": ["approve", "partial", "decline"]},
          "amount_minor": {"type": "integer", "minimum": 0, "description": "Proposed refund in minor units."},
          "reason": {"type": "string", "minLength": 1, "description": "One sentence naming the policy applied."}
        }
      }
    },
    "messages": {
      "type": "array",
      "description": "One reply per case, to the sender.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "about", "facts"],
        "properties": {
          "to": {"type": "string", "minLength": 3},
          "about": {"type": "string", "minLength": 1, "maxLength": 150},
          "facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ref": {"type": "string", "minLength": 1, "description": "The same ref as this case's review item."}
        }
      }
    },
    "review_items": {
      "type": "array",
      "description": "One per case (the shared review item shape).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "date", "amount_minor", "currency", "flag", "note"],
        "properties": {
          "ref": {"type": "string", "minLength": 1, "description": "The order number, or the thread id."},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The request date."},
          "amount_minor": {"type": "integer", "description": "Requested amount in minor units (cents)."},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "flag": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "counterpart_ref": {"type": "string", "minLength": 1, "description": "The charge id."}
        }
      }
    }
  }
}
