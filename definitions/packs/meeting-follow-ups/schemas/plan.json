{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting follow-up plan",
  "description": "Each meeting of the day, whether it needs a follow-up, and one message per outside guest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "meetings", "messages"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "meetings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "title", "start", "follow_up", "reason"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "start": {"type": "string"},
          "follow_up": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "about", "facts", "ref"],
        "properties": {
          "to": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
          "about": {"type": "string", "minLength": 1, "maxLength": 150},
          "facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
