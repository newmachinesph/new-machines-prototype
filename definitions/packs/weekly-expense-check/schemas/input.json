{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly expense check request",
  "type": "object",
  "additionalProperties": false,
  "required": ["week_start", "spreadsheet_id", "expenses_range", "summary_tab", "email_to"],
  "properties": {
    "week_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The first day of the week to check (YYYY-MM-DD). The week is seven days."
    },
    "spreadsheet_id": {
      "type": "string",
      "minLength": 30,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "default": "sandbox-expenses-sheet-0000000000001",
      "description": "The expenses spreadsheet's id, from its URL."
    },
    "expenses_range": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "default": "Expenses!A:E",
      "description": "Where the expenses are, with columns Date, Description, Amount, Paid by and Receipt."
    },
    "summary_tab": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$",
      "default": "Summary",
      "description": "The existing tab the summary rows are added to."
    },
    "email_to": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "description": "Who gets the summary email."
    }
  }
}
