{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent result",
  "description": "What a team's agent returns: a short summary, the messages to draft (the writer's items) and the items a person should check (the reviewer's items).",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "messages", "review_items"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "messages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "about", "facts"],
        "properties": {
          "to": {"type": "string", "minLength": 3},
          "about": {"type": "string", "minLength": 1, "maxLength": 150},
          "facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ref": {"type": "string", "minLength": 1, "description": "The record the message is about, the same ref as its review item."}
        }
      }
    },
    "review_items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "date", "amount_minor", "currency", "flag", "note"],
        "properties": {
          "ref": {"type": "string", "minLength": 1, "description": "The record's id, such as an invoice number."},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "amount_minor": {"type": "integer", "description": "Amount in minor units (cents)."},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "flag": {"type": "string", "minLength": 1, "description": "Why the item needs a look, in a few words."},
          "note": {"type": "string", "minLength": 1, "description": "The agent's reasoning in one sentence."},
          "counterpart_ref": {"type": "string", "minLength": 1, "description": "The related record, such as a charge id."}
        }
      }
    }
  }
}
