{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Email drafts",
  "description": "One short email draft per message, ready to save as a draft for a person to send.",
  "type": "object",
  "additionalProperties": false,
  "required": ["drafts"],
  "properties": {
    "drafts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "subject", "body", "ref"],
        "properties": {
          "to": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 150},
          "body": {"type": "string", "minLength": 1, "maxLength": 4000},
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "The ref of the item the draft is about, such as an invoice number."
          }
        }
      }
    }
  }
}
